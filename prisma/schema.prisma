// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MECANICO
  RECEPCIONISTA
  DUENO
}

enum EstadoOrden {
  PENDIENTE
  EN_PROCESO
  TERMINADO
}

model Usario {
  id        Int      @id @default(autoincrement())
  nombre    String
  email     String  @unique
  password  String  @map("password_hash")
  rol      Role @default (RECEPCIONISTA)
  ordenes   Orden[] @relation("UsuarioOrdenes")
  mecanicoOrdenes Orden[] @relation("MecanicoOrdenes")
  creadoEn   DateTime @default(now())

  @@map("Usuarios")
}

model Orden {
  id          Int         @id @default(autoincrement())
  descripcion String
  estado      EstadoOrden @default(PENDIENTE)
  valorMaoObra Float @default(0)

  usuarioId Int
  usuario   Usario @relation("UsuarioOrdenes", fields: [usuarioId],references: [id])

  mecanicoId Int?
  mecanico   Usario? @relation("MecanicoOrdenes", fields: [mecanicoId], references: [id])

  vehiculoId Int
  vehiculo   Vehiculo @relation(fields: [vehiculoId], references: [id])

  detallesRepuestos DetalleRepuestoOrden[]
  creadoEn DateTime @default(now())

  @@map("ordenes")
}
model Cliente {
  id       Int      @id @default(autoincrement())
  nombre   String
  telefono String?
  email    String?  @unique

  vehiculos Vehiculo[]

  creadoAt DateTime @default(now())

  @@map("clientes")
}
model Vehiculo {
  id Int @id @default(autoincrement())

  placa  String @unique
  marca  String
  modelo String

  clienteId Int
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Restrict)

  ordenes Orden[]

  creadoAt DateTime @default(now())

  @@map("vehiculos")
}
model Repuesto {
  id       Int     @id @default(autoincrement())
  nombre   String
  precio   Float
  stock    Int     @default(0)

  detalles DetalleRepuestoOrden[]

  creadoEn DateTime @default(now())

  @@map("repuestos")
}
model DetalleRepuestoOrden {
  id Int @id @default(autoincrement())

  ordenId Int
  orden  Orden @relation(fields: [ordenId], references: [id])

  repuestoId Int
  repuesto   Repuesto @relation(fields: [repuestoId], references: [id])

  cantidad     Int
  precioUnitario Float

  creadoEn DateTime @default(now())

  @@map("detalle_repuestos_orden")
}